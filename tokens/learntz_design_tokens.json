      "disabled": {
        "main": "#94A3B8",
        "background": "#F1F5F9",
        "border": "#CBD5E1",
        "text": "#64748B"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "Plus Jakarta Sans, Outfit, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
      "body": "Inter, Nunito Sans, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
      "mono": "JetBrains Mono, Fira Code, Consolas, Monaco, monospace"
    },
    "scale": {
      "display": {
        "fontSize": 48,
        "lineHeight": 1.15,
        "fontWeight": 800,
        "letterSpacing": -1.0
      },
      "h1": {
        "fontSize": 36,
        "lineHeight": 1.2,
        "fontWeight": 700,
        "letterSpacing": -0.5
      },
      "h2": {
        "fontSize": 28,
        "lineHeight": 1.25,
        "fontWeight": 700,
        "letterSpacing": -0.25
      },
      "h3": {
        "fontSize": 22,
        "lineHeight": 1.3,
        "fontWeight": 600,
        "letterSpacing": 0
      },
      "h4": {
        "fontSize": 18,
        "lineHeight": 1.35,
        "fontWeight": 600,
        "letterSpacing": 0
      },
      "bodyLarge": {
        "fontSize": 16,
        "lineHeight": 1.6,
        "fontWeight": 400,
        "letterSpacing": 0
      },
      "bodyRegular": {
        "fontSize": 14,
        "lineHeight": 1.55,
        "fontWeight": 400,
        "letterSpacing": 0
      },
      "bodySmall": {
        "fontSize": 12,
        "lineHeight": 1.5,
        "fontWeight": 400,
        "letterSpacing": 0.1
      },
      "caption": {
        "fontSize": 11,
        "lineHeight": 1.4,
        "fontWeight": 500,
        "letterSpacing": 0.2
      },
      "button": {
        "fontSize": 15,
        "lineHeight": 1.2,
        "fontWeight": 600,
        "letterSpacing": 0.1
      }
    }
  },
  "spacing": {
    "grid": 8,
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "xxxl": 64
  },
  "radii": {
    "none": 0,
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 16,
    "xl": 20,
    "xxl": 24,
    "full": 9999
  },
  "elevation": {
    "flat": 0,
    "sm": 1,
    "md": 3,
    "lg": 6,
    "xl": 12
  },
  "touchTargets": {
    "mobileMin": 48,
    "webMin": 44,
    "buttonHeightSm": 36,
    "buttonHeightMd": 44,
    "buttonHeightLg": 52,
    "inputHeight": 52,
    "appBarHeight": 72
  },
  "breakpoints": {
    "mobileMax": 599,
    "tabletMin": 600,
    "tabletMax": 1023,
    "desktopMin": 1024,
    "desktopMax": 1439,
    "wideMin": 1440
  },
  "motion": {
    "durationFast": 150,
    "durationNormal": 250,
    "durationSlow": 400
  }
}
