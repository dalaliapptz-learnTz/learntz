        "300": "#86EFAC",
        "400": "#4ADE80",
        "500": "#22C55E",
        "600": "#16A34A",
        "700": "#15803D",
        "800": "#166534",
        "900": "#14532D"
      },
      "accent": {
        "50": "#FFFBEB",
        "100": "#FEF3C7",
        "200": "#FDE68A",
        "300": "#FCD34D",
        "400": "#FBBF24",
        "500": "#F59E0B",
        "600": "#D97706",
        "700": "#B45309",
        "800": "#92400E",
        "900": "#78350F"
      },
      "neutral": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A",
        "white": "#FFFFFF"
      }
    },
    "semantic": {
      "success": {
        "main": "#15803D",
        "background": "#DCFCE7",
        "border": "#86EFAC",
        "text": "#14532D"
      },
      "warning": {
        "main": "#D97706",
        "background": "#FEF3C7",
        "border": "#FCD34D",
        "text": "#78350F"
      },
      "error": {
        "main": "#DC2626",
        "background": "#FEE2E2",
        "border": "#FCA5A5",
        "text": "#7F1D1D"
